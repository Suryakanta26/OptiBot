# Copy to backend/.env and fill in.
#
# OptiBot talks to exactly one thing: a LiteLLM gateway. Provider keys (Gemini,
# Anthropic, OpenAI, Vertex...) live on that gateway, never here.

# --- Required: the LiteLLM gateway -------------------------------------------
# Include any mount prefix the gateway is served under, e.g.
# https://your-gateway.example.com/litellm. Do NOT include /v1 — OptiBot appends
# it (pasting it anyway is tolerated and stripped).
LITELLM_BASE_URL=http://localhost:4000

# Bearer token OptiBot sends to the gateway. Sent as BOTH
#   Authorization: Bearer <key>
#   x-litellm-api-key: <key>
# because some corporate gateways only honour the second. Leave blank for a local
# proxy with no auth. You can also paste it into the gear-icon panel in the UI,
# but that applies in-process only and is lost on restart.
LITELLM_API_KEY=

# --- Model routing (aliases exactly as the gateway exposes them) --------------
# Baseline deliberately sends EVERY query to the expensive model — that is the
# behaviour being measured against. In a two-model lab setup:
#   fast / cheap -> LITELLM_MODEL_SIMPLE
#   strong       -> LITELLM_MODEL_BASELINE and LITELLM_MODEL_COMPLEX
#
# These are startup defaults only. Whatever you pick in the gear panel is written
# to backend/llm_runtime.json and takes precedence over these. TCS GenAI Lab
# aliases look like gemini-2.5-flash, gemini-2.5-pro, genailab-maas-gpt-4o —
# check the gear panel for the gateway's live list.
LITELLM_MODEL_BASELINE=gemini-2.5-pro
LITELLM_MODEL_SIMPLE=gemini-2.5-flash
LITELLM_MODEL_COMPLEX=gemini-2.5-pro

# --- TLS to the gateway (read-only in the UI; restart to change) --------------
# PREFERRED: trust the corporate CA without weakening verification.
# LITELLM_CA_BUNDLE=C:\certs\corporate-ca.pem
#
# ESCAPE HATCH: disable certificate verification for gateway traffic. Logs a loud
# warning at boot. Use only when you cannot obtain the CA bundle.
# LITELLM_SSL_VERIFY=false
#
# Do NOT set SSL_VERIFY. litellm reads that variable as a raw string at import and
# hands it to httpx as a CA *file path*, so SSL_VERIFY=false stops litellm importing
# at all. OptiBot detects it, ignores it, and warns at boot.
#
# A LITELLM_CA_BUNDLE that is missing or not a valid PEM is not fatal: OptiBot logs
# an error, falls back to the system CA store, and shows it in the settings panel.

# --- Gateway timeouts / retries ----------------------------------------------
LITELLM_TIMEOUT_S=120
LITELLM_CONNECT_TIMEOUT_S=10
LITELLM_MODELS_TIMEOUT_S=10
LITELLM_TEST_TIMEOUT_S=15
LITELLM_MAX_ATTEMPTS=3

# Where model-slot choices made in the UI are persisted. Never holds the key.
# OPTIBOT_LLM_RUNTIME_PATH=

# Comma-separated, for a lab deployment where the UI is not on port 3000.
# OPTIBOT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Semantic cache -----------------------------------------------------------
# 0.80 is calibrated for all-MiniLM-L6-v2 — see scripts/calibrate_cache.py.
# Raise it to trade cache hits for safety.
OPTIBOT_CACHE_THRESHOLD=0.80
OPTIBOT_CACHE_TTL_ORDER=300
OPTIBOT_CACHE_TTL_POLICY=1800
# local (default) or gptcache. GPTCache uses process-local SQLite + FAISS.
OPTIBOT_SEMANTIC_CACHE_BACKEND=local

# --- RAG ----------------------------------------------------------------------
# Embeddings are computed locally (sentence-transformers) and never go through the
# LiteLLM gateway.
OPTIBOT_RAG_TOP_K=3
OPTIBOT_RAG_MIN_SCORE=0.15
